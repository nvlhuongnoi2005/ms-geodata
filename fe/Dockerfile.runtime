# Air-gapped fallback for a workstation that already has the last frontend
# runtime image but not the Node/Nginx build bases. `fe/dist` must be produced
# by `npm run build` before using this Dockerfile.
# Temporary bootstrap runtime for development. Replace with the mirrored Nginx
# base image once the internal registry is available in the offline environment.
ARG RUNTIME_IMAGE=ghcr.io/nvlhuongnoi2005/tile-server/front-end:dev
FROM ${RUNTIME_IMAGE}
COPY fe/nginx.conf /etc/nginx/conf.d/default.conf
COPY fe/dist /usr/share/nginx/html
